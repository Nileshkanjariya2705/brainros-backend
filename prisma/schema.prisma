// ═══════════════════════════════════════════════════════════════════
// EXAM BLUEPRINTS & IMMUTABLE GENERATED VERSIONS (SNAPSHOTS)
// ═══════════════════════════════════════════════════════════════════

model ExamBlueprint {
  id                String          @id @default(uuid()) @db.Uuid
  examId            String          @map("exam_id") @db.Uuid
  name              String
  totalQuestions    Int             @map("total_questions")
  version           Int             @default(1)
  isActive          Boolean         @default(true) @map("is_active")
  isSystem          Boolean         @default(false) @map("is_system")
  createdById       String          @map("created_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  exam              Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  createdBy         User            @relation(fields: [createdById], references: [id])
  rules             BlueprintRule[]
  generatedVersions ExamVersion[]

  @@index([examId])
  @@map("exam_blueprints")
}

model BlueprintRule {
  id                  String                  @id @default(uuid()) @db.Uuid
  blueprintId         String                  @map("blueprint_id") @db.Uuid
  subjectId           String?                 @map("subject_id") @db.Uuid
  chapterId           String?                 @map("chapter_id") @db.Uuid
  topicId             String?                 @map("topic_id") @db.Uuid
  subTopicId          String?                 @map("sub_topic_id") @db.Uuid
  difficultyLevel     QuestionDifficultyEnum? @map("difficulty_level")
  type                QuestionTypeEnum?
  selectionCount      Int?                    @map("selection_count")
  selectionPercentage Float?                  @map("selection_percentage")
  priority            Int                     @default(0)
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")

  blueprint           ExamBlueprint           @relation(fields: [blueprintId], references: [id], onDelete: Cascade)
  subject             Subject?                @relation(fields: [subjectId], references: [id])
  chapter             Chapter?                @relation(fields: [chapterId], references: [id])
  topic               Topic?                  @relation(fields: [topicId], references: [id])
  subTopic            SubTopic?               @relation(fields: [subTopicId], references: [id])

  @@index([blueprintId])
  @@index([subjectId])
  @@index([chapterId])
  @@map("blueprint_rules")
}

model ExamVersion {
  id                    String              @id @default(uuid()) @db.Uuid
  examId                String              @map("exam_id") @db.Uuid
  blueprintId           String?             @map("blueprint_id") @db.Uuid
  versionNumber         Int                 @map("version_number")
  status                ExamVersionStatus   @default(GENERATED)
  generationSeed        String?             @map("generation_seed")
  totalQuestions        Int                 @map("total_questions")
  durationMinutes       Int                 @map("duration_minutes")
  totalMarks            Float               @map("total_marks")
  markingSchemeSnapshot Json?               @map("marking_scheme_snapshot")
  metadata              Json?
  generatedById         String              @map("generated_by_id") @db.Uuid
  generatedAt           DateTime            @default(now()) @map("generated_at")
  publishedAt           DateTime?           @map("published_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  exam                  Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  blueprint             ExamBlueprint?      @relation(fields: [blueprintId], references: [id])
  generatedBy           User                @relation(fields: [generatedById], references: [id])
  questions             ExamVersionQuestion[]
  schedules             ExamSchedule[]
  lifecycleHistories    ExamLifecycleHistory[]
  attempts              Attempt[]
  rankSnapshots         RankSnapshot[]

  @@unique([examId, versionNumber])
  @@index([examId])
  @@index([status])
  @@map("exam_versions")
}

model ExamVersionQuestion {
  id                    String                    @id @default(uuid()) @db.Uuid
  examVersionId         String                    @map("exam_version_id") @db.Uuid
  sourceQuestionId      String                    @map("source_question_id") @db.Uuid
  sourceQuestionVersion Int                       @default(1) @map("source_question_version")
  sequenceNumber        Int                       @map("sequence_number")
  sectionName           String?                   @map("section_name")
  subjectName           String?                   @map("subject_name")
  type                  QuestionTypeEnum
  difficultyLevel       QuestionDifficultyEnum    @map("difficulty_level")
  marks                 Float
  negativeMarks         Float                     @map("negative_marks")
  passage               String?                   @db.Text
  assertion             String?                   @db.Text
  reason                String?                   @db.Text
  questionText          String                    @map("question_text") @db.Text
  explanation           String?                   @db.Text
  correctAnswer         Json?                     @map("correct_answer")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")

  examVersion           ExamVersion               @relation(fields: [examVersionId], references: [id], onDelete: Cascade)
  options               ExamVersionOption[]
  translations          ExamVersionTranslation[]

  @@unique([examVersionId, sourceQuestionId])
  @@index([examVersionId])
  @@index([sequenceNumber])
  @@map("exam_version_questions")
}

model ExamVersionOption {
  id                    String                          @id @default(uuid()) @db.Uuid
  examVersionQuestionId String                          @map("exam_version_question_id") @db.Uuid
  sourceOptionId        String                          @map("source_option_id") @db.Uuid
  displayOrder          Int                             @map("display_order")
  optionKey             String                          @map("option_key")
  optionLabel           String?                         @map("option_label")
  optionText            String                          @map("option_text") @db.Text
  isCorrect             Boolean                         @default(false) @map("is_correct")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")

  question              ExamVersionQuestion             @relation(fields: [examVersionQuestionId], references: [id], onDelete: Cascade)
  translations          ExamVersionOptionTranslation[]

  @@unique([examVersionQuestionId, sourceOptionId])
  @@index([examVersionQuestionId])
  @@index([displayOrder])
  @@map("exam_version_options")
}

model ExamVersionTranslation {
  id                    String              @id @default(uuid()) @db.Uuid
  examVersionQuestionId String              @map("exam_version_question_id") @db.Uuid
  languageId            String              @map("language_id") @db.Uuid
  languageCode          String              @map("language_code")
  questionText          String              @map("question_text") @db.Text
  passageText           String?             @map("passage_text") @db.Text
  assertionText         String?             @map("assertion_text") @db.Text
  reasonText            String?             @map("reason_text") @db.Text
  explanation           String?             @db.Text
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")

  question              ExamVersionQuestion @relation(fields: [examVersionQuestionId], references: [id], onDelete: Cascade)

  @@unique([examVersionQuestionId, languageId])
  @@index([examVersionQuestionId])
  @@map("exam_version_translations")
}

model ExamVersionOptionTranslation {
  id                    String            @id @default(uuid()) @db.Uuid
  examVersionOptionId   String            @map("exam_version_option_id") @db.Uuid
  languageId            String            @map("language_id") @db.Uuid
  languageCode          String            @map("language_code")
  optionText            String            @map("option_text") @db.Text
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")

  option                ExamVersionOption @relation(fields: [examVersionOptionId], references: [id], onDelete: Cascade)

  @@unique([examVersionOptionId, languageId])
  @@index([examVersionOptionId])
  @@map("exam_version_option_translations")
}

// ═══════════════════════════════════════════════════════════════════
// EXAM SCHEDULING & LIFECYCLE AUDIT
// ═══════════════════════════════════════════════════════════════════

model ExamSchedule {
  id                    String                @id @default(uuid()) @db.Uuid
  examId                String                @map("exam_id") @db.Uuid
  examVersionId         String                @map("exam_version_id") @db.Uuid
  startTime             DateTime              @map("start_time")
  endTime               DateTime              @map("end_time")
  timezone              String                @default("Asia/Kolkata")
  status                ExamScheduleStatus    @default(SCHEDULED)
  scheduledById         String                @map("scheduled_by_id") @db.Uuid
  scheduledAt           DateTime              @default(now()) @map("scheduled_at")
  activatedById         String?               @map("activated_by_id") @db.Uuid
  activatedAt           DateTime?             @map("activated_at")
  cancelledById         String?               @map("cancelled_by_id") @db.Uuid
  cancelledAt           DateTime?             @map("cancelled_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  exam                  Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  examVersion           ExamVersion           @relation(fields: [examVersionId], references: [id])
  scheduledBy           User                  @relation("ScheduleCreatedBy", fields: [scheduledById], references: [id])
