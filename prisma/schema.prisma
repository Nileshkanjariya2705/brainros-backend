// EXAM SYSTEM
// ═══════════════════════════════════════════════════════════════════

model ExamStatus {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  exams     Exam[]

  @@map("exam_statuses")
}

model Exam {
  id                         String            @id @default(uuid()) @db.Uuid
  examTargetId               String            @map("exam_target_id") @db.Uuid
  title                      String
  description                String?
  totalQuestions              Int               @map("total_questions")
  totalMarks                 Float             @map("total_marks")
  durationMinutes            Int               @map("duration_minutes")
  defaultMarksPerQuestion    Float             @default(4) @map("default_marks_per_question")
  defaultNegativeMarks       Float             @default(1) @map("default_negative_marks")
  statusId                   String            @map("status_id") @db.Uuid
  examDate                   DateTime?         @map("exam_date")
  startTime                  DateTime?         @map("start_time")
  endTime                    DateTime?         @map("end_time")
  createdById                String            @map("created_by_id") @db.Uuid
  approvedById               String?           @map("approved_by_id") @db.Uuid
  approvedAt                 DateTime?         @map("approved_at")
  activatedAt                DateTime?         @map("activated_at")
  performanceThresholds      Json?             @map("performance_thresholds")
  securityProfileId          String?           @map("security_profile_id") @db.Uuid
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
