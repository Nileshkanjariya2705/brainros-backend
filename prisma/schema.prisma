datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "binary"
  binaryTargets = ["native", "debian-openssl-1.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

// ═══════════════════════════════════════════════════════════════════
// AUTH & IDENTITY ENUMS
// ═══════════════════════════════════════════════════════════════════

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  LOCKED
  DISABLED
  DELETED
}

enum StudentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED
}

enum OtpPurposeEnum {
  LOGIN
  REGISTER
  CHANGE_MOBILE
  RESET_PASSWORD
  VERIFY_MOBILE
  VERIFY_EMAIL
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

enum SecurityEventType {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  OTP_REQUESTED
  OTP_VERIFIED
  OTP_FAILED
  PASSWORD_CHANGED
  REFRESH_REUSE_DETECTED
  SESSION_REVOKED
  LOGOUT
  LOGOUT_ALL
  ACCOUNT_LOCKED
  ROLE_CHANGED
  PERMISSION_CHANGED
  GOOGLE_LINKED
  MOBILE_CHANGED
  EMAIL_CHANGED
  REGISTER_SUCCESS
  TOKEN_REFRESHED
}

enum QuestionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ARCHIVED
}

enum QuestionDifficultyEnum {
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum QuestionTypeEnum {
  SINGLE_CORRECT
  MULTIPLE_CORRECT
  NUMERICAL
  ASSERTION_REASON
  MATCH_FOLLOWING
  CASE_BASED
}

enum ExamVersionStatus {
  DRAFT
  GENERATING
  GENERATED
  PUBLISHED
  ARCHIVED
  FAILED
}

enum ExamScheduleStatus {
  SCHEDULED
  ACTIVE
  ENDED
  CANCELLED
  RESCHEDULED
}


enum ExamLifecycleAction {
  SUBMIT
  APPROVE
  SCHEDULE
  RESCHEDULE
  ACTIVATE
  END
  START_EVALUATION
  COMPLETE
  CANCEL
}

enum ExamSecurityLevel {
  STANDARD
  STRICT
  HIGH_STAKES
  LOCKDOWN
}

enum ExamSessionStatus {
  ACTIVE
  INVALIDATED
  TERMINATED
  EXPIRED
}

enum SecurityClientType {
  STANDARD_BROWSER
  LOCKDOWN_CLIENT
}

enum SecurityReviewStatus {
  PENDING
  CLEARED
  CONFIRMED
  DISQUALIFIED
}

enum SecurityActionType {
  ALLOW
  WARN
  FLAG
  REQUIRE_REAUTH
  LOCK
  AUTO_SUBMIT
  TERMINATE
}

enum AttemptRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id                 String                  @id @default(uuid()) @db.Uuid
  phone              String?                 @unique
  mobileNumber       String?                 @unique @map("mobile_number")
  email              String?                 @unique
  passwordHash       String?                 @map("password_hash")
  status             UserStatus              @default(PENDING)
  isActive           Boolean                 @default(true) @map("is_active")
  isVerified         Boolean                 @default(false) @map("is_verified")
  emailVerifiedAt    DateTime?               @map("email_verified_at")
  mobileVerifiedAt   DateTime?               @map("mobile_verified_at")
  lastLoginAt        DateTime?               @map("last_login_at")
  authVersion        Int                     @default(1) @map("auth_version")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  userRoles          UserRole[]
  student            Student?
  otpVerifications   OtpVerification[]
  refreshTokens      RefreshToken[]
  loginSessions      LoginSession[]
  externalIdentities ExternalIdentity[]
  securityEvents     SecurityEvent[]
  createdQuestions   Question[]              @relation("QuestionCreatedBy")
  submittedQuestions Question[]              @relation("QuestionSubmittedBy")
  reviewedQuestions  Question[]              @relation("QuestionReviewedBy")
  approvedQuestions  Question[]              @relation("QuestionApprovedBy")
  rejectedQuestions  Question[]              @relation("QuestionRejectedBy")
  performedReviews   QuestionReviewHistory[]
  createdExams       Exam[]                  @relation("ExamCreatedBy")
  approvedExams      Exam[]                  @relation("ExamApprovedBy")
  createdBlueprints  ExamBlueprint[]
  generatedVersions  ExamVersion[]
  createdSchedules   ExamSchedule[]          @relation("ScheduleCreatedBy")
  activatedSchedules ExamSchedule[]          @relation("ScheduleActivatedBy")
  cancelledSchedules ExamSchedule[]          @relation("ScheduleCancelledBy")
  performedLifecycles ExamLifecycleHistory[] @relation("LifecyclePerformedBy")
  parentLinks        ParentStudentLink[]    @relation("ParentLinks")
  institutionAdmins  InstitutionAdmin[]
  notificationPreferences NotificationPreference[]
  notifications      Notification[]          @relation("UserNotifications")
  orders             Order[]
  salesOrders        Order[]                 @relation("SalesAgentOrders")
  salesLeads         SalesLead[]             @relation("SalesAgentLeads")
  createdQuestionImports QuestionImport[]    @relation("QuestionImportCreatedBy")
  createdTranslationImports TranslationImport[] @relation("TranslationImportCreatedBy")
  createdExamImports ExamImport[]              @relation("ExamImportCreatedBy")
  examSessions       ExamSession[]
  reviewedSecurityReviews AttemptSecurityReview[]
  publishedResultPublications ExamResultPublication[] @relation("ResultPublishedBy")

  @@index([status])
  @@index([email])
  @@index([mobileNumber])
  @@map("users")
}



model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model StudentClass {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  students    Student[]

  @@map("student_classes")
}

model PreferredLanguage {
  id                          String                      @id @default(uuid()) @db.Uuid
  code                        String?                     @unique
  name                        String                      @unique
  nativeName                  String?                     @map("native_name")
  description                 String?
  isActive                    Boolean                     @default(true) @map("is_active")
  displayOrder                Int                         @default(0) @map("display_order")
  createdAt                   DateTime                    @default(now()) @map("created_at")
  updatedAt                   DateTime                    @updatedAt @map("updated_at")
  students                    Student[]
  questions                   Question[]
  questionTranslations        QuestionTranslation[]
  questionOptionTranslations  QuestionOptionTranslation[]
  attempts                    Attempt[]
  examLanguages               ExamLanguage[]

  @@map("preferred_languages")
}


model ExamTarget {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  students    Student[]
  subjects    Subject[]
  exams       Exam[]
  institutionBatches InstitutionBatch[]
  orders      Order[]

  @@map("exam_targets")
}

model Student {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @map("user_id") @db.Uuid
  studentId           String            @unique @map("student_id")
  studentCode         String?           @unique @map("student_code")
  name                String
  state               String
  district            String
  stateId             String?           @map("state_id") @db.Uuid
  districtId          String?           @map("district_id") @db.Uuid
  schoolCollege       String            @map("school_college")
  classId             String            @map("class_id") @db.Uuid
  examTargetId        String            @map("exam_target_id") @db.Uuid
  preferredLanguageId String            @map("preferred_language_id") @db.Uuid
  status              StudentStatus     @default(ACTIVE)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTarget          ExamTarget        @relation(fields: [examTargetId], references: [id])
  studentClass        StudentClass      @relation(fields: [classId], references: [id])
  preferredLanguage   PreferredLanguage @relation(fields: [preferredLanguageId], references: [id])
  stateRef            State?            @relation(fields: [stateId], references: [id])
  districtRef         District?         @relation(fields: [districtId], references: [id])
  attempts            Attempt[]
  candidateRanks      CandidateRank[]
  parentLinks         ParentStudentLink[]
  batchMemberships    BatchStudent[]
  orders              Order[]
  salesLeads          SalesLead[]

  @@index([status])
  @@index([stateId])
  @@index([districtId])
  @@map("students")
}

model OtpPurpose {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  description      String?
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  otpVerifications OtpVerification[]

  @@map("otp_purposes")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @map("user_id") @db.Uuid
  phone      String
  otpHash    String     @map("otp_hash")
  purposeId  String     @map("purpose_id") @db.Uuid
  expiresAt  DateTime   @map("expires_at")
  verifiedAt DateTime?  @map("verified_at")
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now()) @map("created_at")
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  otpPurpose OtpPurpose @relation(fields: [purposeId], references: [id])

  @@index([phone])
  @@index([userId])
  @@map("otp_verifications")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionId         String?   @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  replacedByTokenId String?   @unique @map("replaced_by_token_id") @db.Uuid
  lastUsedAt        DateTime? @map("last_used_at")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  session           LoginSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  replacedByToken   RefreshToken? @relation("TokenRotation", fields: [replacedByTokenId], references: [id])
  previousToken     RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

// ═══════════════════════════════════════════════════════════════════
// RBAC PERMISSION MODEL
// ═══════════════════════════════════════════════════════════════════

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  code            String           @unique
  description     String?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ═══════════════════════════════════════════════════════════════════
// LOGIN SESSION & SECURITY
// ═══════════════════════════════════════════════════════════════════

model LoginSession {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceId        String?   @map("device_id")
  userAgent       String?   @map("user_agent")
  ipAddress       String?   @map("ip_address")
  lastActivityAt  DateTime  @default(now()) @map("last_activity_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens   RefreshToken[]

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("login_sessions")
}

model ExternalIdentity {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  provider        AuthProvider
  providerSubject String       @map("provider_subject")
  email           String?
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("external_identities")
}

model SecurityEvent {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String?           @map("user_id") @db.Uuid
  eventType   SecurityEventType @map("event_type")
  ipAddress   String?           @map("ip_address")
  userAgent   String?           @map("user_agent")
  metadata    Json?
  createdAt   DateTime          @default(now()) @map("created_at")
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("security_events")
}

// ═══════════════════════════════════════════════════════════════════
// GEOGRAPHIC MASTER DATA
// ═══════════════════════════════════════════════════════════════════

model State {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  code        String     @unique
  countryCode String     @default("IN") @map("country_code")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  districts   District[]
  students    Student[]

  @@map("states")
}

model District {
  id        String    @id @default(uuid()) @db.Uuid
  stateId   String    @map("state_id") @db.Uuid
  name      String
  code      String?
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  state     State     @relation(fields: [stateId], references: [id], onDelete: Cascade)
  students  Student[]

  @@unique([stateId, name])
  @@index([stateId])
  @@map("districts")
}

// ═══════════════════════════════════════════════════════════════════
// ACADEMIC HIERARCHY
// ═══════════════════════════════════════════════════════════════════

model Subject {
  id            String         @id @default(uuid()) @db.Uuid
  examTargetId  String         @map("exam_target_id") @db.Uuid
  name          String
  code          String?
  displayOrder  Int            @default(0) @map("display_order")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  examTarget    ExamTarget     @relation(fields: [examTargetId], references: [id])
  chapters      Chapter[]
  questions     Question[]
  examSections  ExamSection[]
  subjectResults SubjectResult[]
  blueprintRules BlueprintRule[]

  @@unique([examTargetId, name])
  @@index([examTargetId])
  @@map("subjects")
}

model Chapter {
  id             String          @id @default(uuid()) @db.Uuid
  subjectId      String          @map("subject_id") @db.Uuid
  name           String
  code           String?
  description    String?
  displayOrder   Int             @default(0) @map("display_order")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  subject        Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics         Topic[]
  questions      Question[]
  chapterResults ChapterResult[]
  blueprintRules BlueprintRule[]

  @@unique([subjectId, name])
  @@index([subjectId])
  @@map("chapters")
}

model Topic {
  id           String     @id @default(uuid()) @db.Uuid
  chapterId    String     @map("chapter_id") @db.Uuid
  name         String
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  chapter      Chapter    @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  subTopics    SubTopic[]
  questions    Question[]
  blueprintRules BlueprintRule[]

  @@unique([chapterId, name])
  @@index([chapterId])
  @@map("topics")
}

model SubTopic {
  id           String     @id @default(uuid()) @db.Uuid
  topicId      String     @map("topic_id") @db.Uuid
  name         String
  displayOrder Int        @default(0) @map("display_order")
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  topic        Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  questions    Question[]
  blueprintRules BlueprintRule[]

  @@unique([topicId, name])
  @@index([topicId])
  @@map("sub_topics")
}


// ═══════════════════════════════════════════════════════════════════
// QUESTION BANK
// ═══════════════════════════════════════════════════════════════════

model DifficultyLevel {
  id           String     @id @default(uuid()) @db.Uuid
  name         String     @unique
  displayOrder Int        @default(0) @map("display_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  questions    Question[]

  @@map("difficulty_levels")
}

model QuestionType {
  id               String             @id @default(uuid()) @db.Uuid
  name             String             @unique
  code             String             @unique
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")
  questions        Question[]
  examScoringRules ExamScoringRule[]

  @@map("question_types")
}

model Question {
  id                  String                    @id @default(uuid()) @db.Uuid
  subjectId           String                    @map("subject_id") @db.Uuid
  chapterId           String                    @map("chapter_id") @db.Uuid
  topicId             String?                   @map("topic_id") @db.Uuid
  subTopicId          String?                   @map("sub_topic_id") @db.Uuid
  difficultyId        String?                   @map("difficulty_id") @db.Uuid
  difficultyLevel     QuestionDifficultyEnum    @default(MEDIUM) @map("difficulty_level")
  questionTypeId      String?                   @map("question_type_id") @db.Uuid
  type                QuestionTypeEnum          @default(SINGLE_CORRECT)
  status              QuestionStatus            @default(DRAFT)
  version             Int                       @default(1)
  parentQuestionId    String?                   @map("parent_question_id") @db.Uuid
  defaultLanguageId   String                    @map("default_language_id") @db.Uuid
  correctAnswer       Json?                     @map("correct_answer")
  marks               Float                     @default(4)
  negativeMarks       Float                     @default(1) @map("negative_marks")
  passage             String?                   @db.Text
  assertion           String?                   @db.Text
  reason              String?                   @db.Text
  isActive            Boolean                   @default(true) @map("is_active")
  createdById         String                    @map("created_by_id") @db.Uuid
  submittedById       String?                   @map("submitted_by_id") @db.Uuid
  submittedAt         DateTime?                 @map("submitted_at")
  reviewedById        String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt          DateTime?                 @map("reviewed_at")
  approvedById        String?                   @map("approved_by_id") @db.Uuid
  approvedAt          DateTime?                 @map("approved_at")
  rejectedById        String?                   @map("rejected_by_id") @db.Uuid
  rejectedAt          DateTime?                 @map("rejected_at")
  rejectionReason     String?                   @map("rejection_reason") @db.Text
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  subject             Subject                   @relation(fields: [subjectId], references: [id])
  chapter             Chapter                   @relation(fields: [chapterId], references: [id])
  topic               Topic?                    @relation(fields: [topicId], references: [id])
  subTopic            SubTopic?                 @relation(fields: [subTopicId], references: [id])
  difficulty          DifficultyLevel?          @relation(fields: [difficultyId], references: [id])
  questionType        QuestionType?             @relation(fields: [questionTypeId], references: [id])
  defaultLanguage     PreferredLanguage         @relation(fields: [defaultLanguageId], references: [id])
  createdBy           User                      @relation("QuestionCreatedBy", fields: [createdById], references: [id])
  submittedBy         User?                     @relation("QuestionSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy          User?                     @relation("QuestionReviewedBy", fields: [reviewedById], references: [id])
  approvedBy          User?                     @relation("QuestionApprovedBy", fields: [approvedById], references: [id])
  rejectedBy          User?                     @relation("QuestionRejectedBy", fields: [rejectedById], references: [id])
  parentQuestion      Question?                 @relation("QuestionVersions", fields: [parentQuestionId], references: [id])
  childVersions       Question[]                @relation("QuestionVersions")
  options             QuestionOption[]
  answer              QuestionAnswer?
  explanation         QuestionExplanation?
  translations        QuestionTranslation[]
  reviewHistory       QuestionReviewHistory[]
  examQuestions       ExamQuestion[]

  @@index([subjectId])
  @@index([chapterId])
  @@index([topicId])
  @@index([subTopicId])
  @@index([difficultyLevel])
  @@index([type])
  @@index([status])
  @@index([version])
  @@index([createdById])
  @@index([createdAt])
  @@map("questions")
}

model QuestionTranslation {
  id            String            @id @default(uuid()) @db.Uuid
  questionId    String            @map("question_id") @db.Uuid
  languageId    String            @map("language_id") @db.Uuid
  questionText  String            @map("question_text") @db.Text
  passageText   String?           @map("passage_text") @db.Text
  assertionText String?           @map("assertion_text") @db.Text
  reasonText    String?           @map("reason_text") @db.Text
  explanation   String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  question      Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  language      PreferredLanguage @relation(fields: [languageId], references: [id])

  @@unique([questionId, languageId])
  @@index([languageId])
  @@map("question_translations")
}

model QuestionOption {
  id           String                      @id @default(uuid()) @db.Uuid
  questionId   String                      @map("question_id") @db.Uuid
  optionKey    String                      @default("A") @map("option_key")
  optionLabel  String?                     @map("option_label")
  optionText   String?                     @map("option_text") @db.Text
  matchColumn  String?                     @map("match_column")
  matchPairKey String?                     @map("match_pair_key")
  isCorrect    Boolean                     @default(false) @map("is_correct")
  displayOrder Int                         @default(0) @map("display_order")
  createdAt    DateTime                    @default(now()) @map("created_at")
  updatedAt    DateTime                    @updatedAt @map("updated_at")
  question     Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations           QuestionOptionTranslation[]
  answers                Answer[]
  attemptQuestionOptions AttemptQuestionOption[]

  @@index([questionId])
  @@map("question_options")
}

model QuestionOptionTranslation {
  id         String            @id @default(uuid()) @db.Uuid
  optionId   String            @map("option_id") @db.Uuid
  languageId String            @map("language_id") @db.Uuid
  optionText String            @map("option_text") @db.Text
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")
  option     QuestionOption    @relation(fields: [optionId], references: [id], onDelete: Cascade)
  language   PreferredLanguage @relation(fields: [languageId], references: [id])

  @@unique([optionId, languageId])
  @@index([languageId])
  @@map("question_option_translations")
}


model QuestionAnswer {
