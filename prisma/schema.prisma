model ExamLifecycleHistory {
  id                    String                @id @default(uuid()) @db.Uuid
  examId                String                @map("exam_id") @db.Uuid
  examVersionId         String?               @map("exam_version_id") @db.Uuid
  scheduleId            String?               @map("schedule_id") @db.Uuid
  action                ExamLifecycleAction
  fromStatus            String                @map("from_status")
  toStatus              String                @map("to_status")
  performedById         String                @map("performed_by_id") @db.Uuid
  comment               String?               @db.Text
  metadata              Json?
  createdAt             DateTime              @default(now()) @map("created_at")

  exam                  Exam                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  examVersion           ExamVersion?          @relation(fields: [examVersionId], references: [id])
  schedule              ExamSchedule?         @relation(fields: [scheduleId], references: [id])
  performedBy           User                  @relation("LifecyclePerformedBy", fields: [performedById], references: [id])

  @@index([examId])
  @@index([performedById])
  @@index([createdAt])
  @@map("exam_lifecycle_histories")
}

// ═══════════════════════════════════════════════════════════════════
// RANK & PERCENTILE ENGINE
// ═══════════════════════════════════════════════════════════════════

enum RankType {
  OVERALL
  STATE
  DISTRICT
  SCHOOL
  COLLEGE
  INSTITUTION
  CATEGORY
}

enum RankSnapshotStatus {
  PENDING
  PROCESSING
  VALIDATING
  COMPLETED
  FAILED
}

model RankSnapshot {
  id                    String              @id @default(uuid()) @db.Uuid
  examId                String              @map("exam_id") @db.Uuid
  examVersionId         String?             @map("exam_version_id") @db.Uuid
  snapshotVersion       Int                 @default(1) @map("snapshot_version")
  algorithmVersion      String              @default("v1.0.0") @map("algorithm_version")
  configVersion         Int                 @default(1) @map("config_version")
  status                RankSnapshotStatus  @default(PENDING)
  totalCandidates       Int                 @default(0) @map("total_candidates")
  highestScore          Float?              @map("highest_score")
  lowestScore           Float?              @map("lowest_score")
  averageScore          Float?              @map("average_score")
  medianScore           Float?              @map("median_score")
  metadata              Json?               @map("metadata")
  integrityChecksPassed Boolean             @default(false) @map("integrity_checks_passed")
  generatedAt           DateTime            @default(now()) @map("generated_at")
  completedAt           DateTime?           @map("completed_at")
  exam                  Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)
  examVersion           ExamVersion?        @relation(fields: [examVersionId], references: [id], onDelete: SetNull)
  candidateRanks        CandidateRank[]

  @@unique([examId, snapshotVersion])
  @@index([examId])
  @@index([status])
  @@map("rank_snapshots")
}

model CandidateRank {
  id                     String        @id @default(uuid()) @db.Uuid
  rankSnapshotId         String        @map("rank_snapshot_id") @db.Uuid
  attemptId              String        @map("attempt_id") @db.Uuid
  studentId              String        @map("student_id") @db.Uuid
  rankType               RankType      @map("rank_type")
  scopeId                String?       @map("scope_id")
  scopeName              String?       @map("scope_name")
  categoryId             String?       @map("category_id")
  categoryName           String?       @map("category_name")
  rank                   Int
  totalCandidates        Int           @map("total_candidates")
  percentile             Float
  score                  Float
  accuracy               Float
  timeUsedSeconds        Int?          @map("time_used_seconds")
  predictedRankMin       Int?          @map("predicted_rank_min")
  predictedRankMax       Int?          @map("predicted_rank_max")
  predictionConfidence   String?       @map("prediction_confidence") // HIGH, MEDIUM, LOW
  predictionModelVersion String?       @map("prediction_model_version")
  createdAt              DateTime      @default(now()) @map("created_at")
  rankSnapshot           RankSnapshot  @relation(fields: [rankSnapshotId], references: [id], onDelete: Cascade)
  attempt                Attempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student                Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([rankSnapshotId, attemptId, rankType, scopeId, categoryId])
  @@index([attemptId])
  @@index([studentId])
  @@index([rankSnapshotId, rankType])
  @@index([rankSnapshotId, rankType, scopeId])
  @@index([rankSnapshotId, rankType, rank])
  @@map("candidate_ranks")
}

model RankingConfig {
  id                  String    @id @default(uuid()) @db.Uuid
  examId              String?   @map("exam_id") @db.Uuid
  examTargetId        String?   @map("exam_target_id") @db.Uuid
  rankMode            String    @default("COMPETITION") @map("rank_mode") // COMPETITION, DENSE, ORDINAL
  tieBreakOrder       Json?     @map("tie_break_order") // Array of field names
  percentileMethod    String    @default("STANDARD") @map("percentile_method") // STANDARD, FRACTIONAL
  version             Int       @default(1)
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  exam                Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([isActive])
  @@map("ranking_configs")
}

// ═══════════════════════════════════════════════════════════════════
// PREDICTED RANK ENGINE
// ═══════════════════════════════════════════════════════════════════

enum DataQualityStatus {
  PENDING_VALIDATION
  VALID
  INVALID
  PARTIALLY_VALID
  ARCHIVED
}

enum PredictionStatus {
  PENDING
  PROCESSING
  COMPLETED
  UNAVAILABLE
  FAILED
}

model HistoricalExam {
  id                String                 @id @default(uuid()) @db.Uuid
  examName          String                 @map("exam_name")
  examType          String                 @map("exam_type") // NEET, JEE_MAIN, JEE_ADVANCED, BITSAT, etc.
  examDate          DateTime?              @map("exam_date")
  durationMinutes   Int                    @default(180) @map("duration_minutes")
  totalMarks        Float                  @map("total_marks")
  totalCandidates   Int                    @map("total_candidates")
  source            String                 @default("INTERNAL_RESULTS") // OFFICIAL_SOURCE, ADMIN_IMPORT, INTERNAL_RESULTS, PARTNER_DATA
  dataQualityStatus DataQualityStatus      @default(PENDING_VALIDATION) @map("data_quality_status")
  datasetVersion    Int                    @default(1) @map("dataset_version")
  qualityScore      Float?                 @map("quality_score")
  metadata          Json?
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  datasets          HistoricalRankDataset[]
  scoreRanges       HistoricalScoreRange[]

  @@index([examType])
  @@index([dataQualityStatus])
  @@index([totalMarks])
  @@map("historical_exams")
}

model HistoricalRankDataset {
  id               String          @id @default(uuid()) @db.Uuid
  historicalExamId String          @map("historical_exam_id") @db.Uuid
  score            Float
  rank             Int
  totalCandidates  Int             @map("total_candidates")
  percentile       Float?
  category         String?
  state            String?
  datasetVersion   Int             @default(1) @map("dataset_version")
  createdAt        DateTime        @default(now()) @map("created_at")

  historicalExam   HistoricalExam  @relation(fields: [historicalExamId], references: [id], onDelete: Cascade)

  @@index([historicalExamId])
  @@index([score])
  @@index([rank])
  @@map("historical_rank_datasets")
}

model HistoricalScoreRange {
  id                  String          @id @default(uuid()) @db.Uuid
  historicalExamId    String          @map("historical_exam_id") @db.Uuid
  minScore            Float           @map("min_score")
  maxScore            Float           @map("max_score")
  representativeScore Float           @map("representative_score")
  minRank             Int             @map("min_rank")
  maxRank             Int             @map("max_rank")
  candidateCount      Int             @map("candidate_count")
  totalCandidates     Int             @map("total_candidates")
  percentileMin       Float?          @map("percentile_min")
  percentileMax       Float?          @map("percentile_max")
  datasetVersion      Int             @default(1) @map("dataset_version")
  createdAt           DateTime        @default(now()) @map("created_at")

  historicalExam      HistoricalExam  @relation(fields: [historicalExamId], references: [id], onDelete: Cascade)

  @@index([historicalExamId])
  @@index([minScore, maxScore])
  @@map("historical_score_ranges")
}

model PredictionModelConfig {
  id            String    @id @default(uuid()) @db.Uuid
  modelCode     String    @unique @map("model_code") // HISTORICAL_INTERPOLATION
  modelName     String    @map("model_name")
  version       String    @default("v1.0.0")
  configuration Json?     // minHistoricalExams, minTotalCandidates, confidenceThresholds
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("prediction_model_configs")
}

model PredictionResult {
  id                  String                 @id @default(uuid()) @db.Uuid
  attemptId           String                 @map("attempt_id") @db.Uuid
  examVersionId       String?                @map("exam_version_id") @db.Uuid
  modelCode           String                 @default("HISTORICAL_INTERPOLATION") @map("model_code")
  modelVersion        String                 @default("v1.0.0") @map("model_version")
  configVersion       Int                    @default(1) @map("config_version")
  datasetVersion      Int                    @default(1) @map("dataset_version")
  inputScore          Float                  @map("input_score")
  normalizedScore     Float                  @map("normalized_score")
  predictedRank       Int?                   @map("predicted_rank")
  predictedRankMin    Int?                   @map("predicted_rank_min")
  predictedRankMax    Int?                   @map("predicted_rank_max")
  confidence          String?                @map("confidence") // HIGH, MEDIUM, LOW
  confidenceScore     Float?                 @map("confidence_score") // 0 - 100
  percentileEstimate  Float?                 @map("percentile_estimate")
  historicalExamCount Int                    @default(0) @map("historical_exam_count")
  datasetSize         Int                    @default(0) @map("dataset_size")
  status              PredictionStatus       @default(COMPLETED)
  unavailableReason   String?                @map("unavailable_reason")
  explanation         Json?
  generatedAt         DateTime               @default(now()) @map("generated_at")
  createdAt           DateTime               @default(now()) @map("created_at")

  attempt             Attempt                @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  evaluations         PredictionEvaluation[]

  @@unique([attemptId, modelVersion, configVersion, datasetVersion])
  @@index([attemptId])
  @@index([status])
  @@map("prediction_results")
}

model PredictionEvaluation {
  id                   String            @id @default(uuid()) @db.Uuid
  predictionResultId   String            @map("prediction_result_id") @db.Uuid
  actualRank           Int               @map("actual_rank")
  predictedRank        Int               @map("predicted_rank")
  absoluteError        Int               @map("absolute_error")
  relativeError        Float             @map("relative_error")
  withinPredictedRange Boolean           @map("within_predicted_range")
  evaluatedAt          DateTime          @default(now()) @map("evaluated_at")
  createdAt            DateTime          @default(now()) @map("created_at")

  predictionResult     PredictionResult  @relation(fields: [predictionResultId], references: [id], onDelete: Cascade)

  @@index([predictionResultId])
  @@map("prediction_evaluations")
}

// ═══════════════════════════════════════════════════════════════════
// PARENT - STUDENT ACCESS & DASHBOARD
// ═══════════════════════════════════════════════════════════════════

enum ParentRelationshipType {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum ParentLinkStatus {
  ACTIVE
  PENDING
  REVOKED
  REJECTED
}

model ParentStudentLink {
  id               String                 @id @default(uuid()) @db.Uuid
  parentId         String                 @map("parent_id") @db.Uuid
  studentId        String                 @map("student_id") @db.Uuid
  relationshipType ParentRelationshipType @default(GUARDIAN) @map("relationship_type")
  status           ParentLinkStatus       @default(ACTIVE) @map("status")
  linkedAt         DateTime               @default(now()) @map("linked_at")
  approvedAt       DateTime?              @map("approved_at")
  revokedAt        DateTime?              @map("revoked_at")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  parent           User                   @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student          Student                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
  @@index([status])
  @@map("parent_student_links")
}


// ═══════════════════════════════════════════════════════════════════
// INSTITUTION / B2B MANAGEMENT
// ═══════════════════════════════════════════════════════════════════

enum InstitutionType {
  COACHING
  SCHOOL
  COLLEGE
  UNIVERSITY
  TRAINING_CENTER
  OTHER
}

enum InstitutionStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  ACTIVE
  SUSPENDED
  CANCELLED
  ARCHIVED
}

enum BatchStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum BatchStudentStatus {
  ACTIVE
  LEFT
  SUSPENDED
  REMOVED
}

enum BulkUploadStatus {
  UPLOADED
  PARSING
  VALIDATING
  READY_FOR_REVIEW
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  ACTIVATING
  ACTIVATED
  PARTIALLY_ACTIVATED
  FAILED
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum ReportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum ReportType {
  STUDENT_WISE
  BATCH_WISE
  SUBJECT_ANALYSIS
  CHAPTER_ANALYSIS
  RANK_LIST
}

enum ReportFormat {
  XLSX
  PDF
}

model Institution {
  id          String            @id @default(uuid()) @db.Uuid
  name        String
  code        String            @unique
  type        InstitutionType   @default(COACHING)
  status      InstitutionStatus @default(DRAFT)
  email       String?
  phone       String?
  address     String?
  city        String?
  state       String?
  country     String?           @default("India")
  logo        String?
  settings    Json?
  createdById String            @map("created_by_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  admins      InstitutionAdmin[]
  batches     InstitutionBatch[]
  bulkUploads BulkUpload[]
  reportJobs  ReportJob[]

  @@index([status])
  @@index([code])
  @@map("institutions")
}

model InstitutionAdmin {
  id              String      @id @default(uuid()) @db.Uuid
  institutionId   String      @map("institution_id") @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  role            String      @default("ADMIN")  // OWNER, ADMIN, ACADEMIC, OPERATIONS
  isActive        Boolean     @default(true) @map("is_active")
  assignedAt      DateTime    @default(now()) @map("assigned_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([institutionId, userId])
  @@index([userId])
  @@index([institutionId])
  @@map("institution_admins")
}

model InstitutionBatch {
  id              String      @id @default(uuid()) @db.Uuid
  institutionId   String      @map("institution_id") @db.Uuid
  name            String
  academicYear    String?     @map("academic_year")
  examTargetId    String?     @map("exam_target_id") @db.Uuid
  classLevel      String?     @map("class_level")
  status          BatchStatus @default(DRAFT)
  startDate       DateTime?   @map("start_date")
  endDate         DateTime?   @map("end_date")
  createdById     String      @map("created_by_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  examTarget      ExamTarget?  @relation(fields: [examTargetId], references: [id])
  students        BatchStudent[]
  bulkUploads     BulkUpload[]

  @@unique([institutionId, name])
  @@index([institutionId])
  @@index([status])
  @@map("institution_batches")
}

model BatchStudent {
  id          String             @id @default(uuid()) @db.Uuid
  batchId     String             @map("batch_id") @db.Uuid
  studentId   String             @map("student_id") @db.Uuid
  status      BatchStudentStatus @default(ACTIVE)
  joinedAt    DateTime           @default(now()) @map("joined_at")
  leftAt      DateTime?          @map("left_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  batch       InstitutionBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student     Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([batchId, studentId])
  @@index([batchId])
  @@index([studentId])
  @@index([status])
  @@map("batch_students")
}

model BulkUpload {
  id                String           @id @default(uuid()) @db.Uuid
  institutionId     String?          @map("institution_id") @db.Uuid
  batchId           String?          @map("batch_id") @db.Uuid
  uploadType        String           @default("SUPER_ADMIN_STUDENTS") @map("upload_type")
  fileName          String           @map("file_name")
  fileType          String           @map("file_type")
  storageKey        String?          @map("storage_key")
  fileSize          Int?             @map("file_size")
  checksum          String?
  rowCount          Int              @default(0) @map("row_count")
  validRowCount     Int              @default(0) @map("valid_row_count")
  invalidRowCount   Int              @default(0) @map("invalid_row_count")
  duplicateRowCount Int              @default(0) @map("duplicate_row_count")
  existingStudentCount Int           @default(0) @map("existing_student_count")
  newStudentCount   Int              @default(0) @map("new_student_count")
  activatedCount    Int              @default(0) @map("activated_count")
  failedCount       Int              @default(0) @map("failed_count")
  status            BulkUploadStatus @default(UPLOADED)
  uploadedById      String           @map("uploaded_by_id") @db.Uuid
  processedAt       DateTime?        @map("processed_at")
  submittedAt       DateTime?        @map("submitted_at")
  approvedAt        DateTime?        @map("approved_at")
  approvedById      String?          @map("approved_by_id") @db.Uuid
  rejectionReason   String?          @map("rejection_reason")
  activatedAt       DateTime?        @map("activated_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  institution       Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  batch             InstitutionBatch? @relation(fields: [batchId], references: [id])
  rows              BulkUploadRow[]
  errors            BulkUploadError[]
  approvalRequests  ApprovalRequest[]

  @@index([institutionId])
  @@index([status])
  @@index([uploadType])
  @@map("bulk_uploads")
}

model BulkUploadRow {
  id                    String           @id @default(uuid()) @db.Uuid
  uploadId              String           @map("upload_id") @db.Uuid
  rowNumber             Int              @map("row_number")
  rawData               Json             @map("raw_data")
  normalizedData        Json?            @map("normalized_data")
  validationStatus      String           @default("PENDING") @map("validation_status") // PENDING, VALID, INVALID
  deduplicationStatus   String           @default("PENDING") @map("deduplication_status") // PENDING, UNIQUE, DUPLICATE_IN_FILE, EXISTING_STUDENT, ALREADY_IN_BATCH
  matchedStudentId      String?          @map("matched_student_id") @db.Uuid
  errorCount            Int              @default(0) @map("error_count")
  activationStatus      String           @default("PENDING") @map("activation_status") // PENDING, ACTIVATED, FAILED, SKIPPED
  activationError       String?          @map("activation_error")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")

  upload                BulkUpload       @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  errors                BulkUploadError[]

  @@unique([uploadId, rowNumber])
  @@index([uploadId])
  @@index([validationStatus])
  @@map("bulk_upload_rows")
}

model BulkUploadError {
  id          String        @id @default(uuid()) @db.Uuid
  uploadId    String        @map("upload_id") @db.Uuid
  rowId       String?       @map("row_id") @db.Uuid
  rowNumber   Int?          @map("row_number")
  field       String
  errorCode   String        @map("error_code")
  message     String
  createdAt   DateTime      @default(now()) @map("created_at")

  upload      BulkUpload    @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  row         BulkUploadRow? @relation(fields: [rowId], references: [id], onDelete: Cascade)

  @@index([uploadId])
  @@index([rowId])
  @@map("bulk_upload_errors")
}

model ApprovalRequest {
  id                String                @id @default(uuid()) @db.Uuid
  resourceType      String                @map("resource_type") // QUESTION, QUESTION_TRANSLATION, EXAM, INSTITUTION, BULK_UPLOAD, etc.
  resourceId        String                @map("resource_id") @db.Uuid
  requestedById     String                @map("requested_by_id") @db.Uuid
  status            ApprovalRequestStatus @default(PENDING)
  reviewedById      String?               @map("reviewed_by_id") @db.Uuid
  submittedAt       DateTime?             @default(now()) @map("submitted_at")
  reviewedAt        DateTime?             @map("reviewed_at")
  rejectionReason   String?               @map("rejection_reason")
  reviewComment     String?               @map("review_comment")
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  bulkUpload        BulkUpload?           @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([resourceType, resourceId])
  @@index([status])
  @@index([requestedById])
  @@index([reviewedById])
  @@map("approval_requests")
}

model ReportJob {
  id              String          @id @default(uuid()) @db.Uuid
  institutionId   String          @map("institution_id") @db.Uuid
  requestedById   String          @map("requested_by_id") @db.Uuid
  reportType      ReportType      @map("report_type")
  format          ReportFormat    @default(XLSX)
  filters         Json?
  status          ReportJobStatus @default(QUEUED)
  progress        Int             @default(0)
  storageKey      String?         @map("storage_key")
  fileName        String?         @map("file_name")
  fileSize        Int?            @map("file_size")
  error           String?
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  expiresAt       DateTime?       @map("expires_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  institution     Institution     @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@index([institutionId])
  @@index([status])
  @@map("report_jobs")
}

model AuditLog {
  id            String    @id @default(uuid()) @db.Uuid
  actorUserId   String?   @map("actor_user_id") @db.Uuid
  action        String    // APPROVE, REJECT, CANCEL, ACTIVATE_EXAM, DEACTIVATE_EXAM, BULK_ACTIVATE, etc.
  entityType    String    @map("entity_type")
  entityId      String    @map("entity_id")
  beforeState   Json?     @map("before_state")
  afterState    Json?     @map("after_state")
  reason        String?
  metadata      Json?
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent")
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════
// NOTIFICATION & COMMUNICATION ENUMS & MODELS
// ═══════════════════════════════════════════════════════════════════

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationType {
  OTP
  REGISTRATION_CONFIRMATION
  EXAM_APPROVED
  EXAM_SCHEDULED
  EXAM_RESCHEDULED
  EXAM_CANCELLED
  EXAM_REMINDER
  EXAM_ACTIVATED
  EXAM_STARTING_SOON
  EXAM_ENDED
  EXAM_RESULT_PUBLISHED
  RESULT_AVAILABLE
  REPORT_READY
  PAYMENT_CONFIRMATION
  INSTITUTION_APPROVED
  BULK_UPLOAD_COMPLETED
  SECURITY_ALERT
}

enum NotificationStatus {
  PENDING
  QUEUED
  PROCESSING
  SENT
  DELIVERED
  FAILED
  RETRYING
  CANCELLED
  EXPIRED
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

model NotificationTemplate {
  id               String              @id @default(uuid()) @db.Uuid
  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  languageCode     String              @default("en") @map("language_code")
  subject          String?
  body             String
  variables        Json?
  version          Int                 @default(1)
  isActive         Boolean             @default(true) @map("is_active")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  notifications    Notification[]

  @@unique([notificationType, channel, languageCode, version])
  @@index([notificationType, channel, languageCode])
  @@map("notification_templates")
}

model NotificationPreference {
  id               String              @id @default(uuid()) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  notificationType NotificationType    @map("notification_type")
  channel          NotificationChannel
  enabled          Boolean             @default(true)
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, channel])
  @@index([userId])
  @@map("notification_preferences")
}

model Notification {
  id                 String               @id @default(uuid()) @db.Uuid
  userId             String?              @map("user_id") @db.Uuid
  recipientUserId    String?              @map("recipient_user_id") @db.Uuid
  recipientAddress   String?              @map("recipient_address")
  channel            NotificationChannel  @default(IN_APP)
  type               NotificationType
  title              String?
  message            String?
  data               Json?
  isRead             Boolean              @default(false) @map("is_read")
  readAt             DateTime?            @map("read_at")
  templateId         String?              @map("template_id") @db.Uuid
  templateVersion    Int                  @default(1) @map("template_version")
  payload            Json?
  priority           NotificationPriority @default(NORMAL)
  status             NotificationStatus   @default(PENDING)
  scheduledAt        DateTime?            @map("scheduled_at")
  sentAt             DateTime?            @map("sent_at")
  expiresAt          DateTime?            @map("expires_at")
  correlationId      String?              @map("correlation_id")
  idempotencyKey     String?              @unique @map("idempotency_key")
  scheduleVersion    Int                  @default(1) @map("schedule_version")
  attempts           Int                  @default(0)
  maxAttempts        Int                  @default(3) @map("max_attempts")
  lastError          String?              @map("last_error")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  user               User?                @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  template           NotificationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs               NotificationLog[]

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([recipientUserId])
  @@index([type])
  @@index([status])
  @@index([channel])
  @@index([scheduledAt])
  @@map("notifications")
}

model NotificationLog {
  id                 String              @id @default(uuid()) @db.Uuid
  notificationId     String              @map("notification_id") @db.Uuid
  channel            NotificationChannel
  provider           String
  providerMessageId  String?             @map("provider_message_id")
  attemptNumber      Int                 @map("attempt_number")
  status             NotificationStatus
  requestTime        DateTime            @default(now()) @map("request_time")
  responseTime       DateTime?           @map("response_time")
  errorCode          String?             @map("error_code")
  errorMessage       String?             @map("error_message")
  createdAt          DateTime            @default(now()) @map("created_at")

  notification       Notification        @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([provider])
  @@index([status])
  @@index([createdAt])
  @@map("notification_logs")
}

// ═══════════════════════════════════════════════════════════════════
// EXAM CALENDAR, CYCLES & FEATURE ACTIVATION GATES
// ═══════════════════════════════════════════════════════════════════

enum ExamCycleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum CalendarEventStatus {
  PLANNED
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum FeatureCode {
  EXAM_ACCESS
  RESULT_ACCESS
  RANKING
  PREDICTED_RANK
  PARENT_ACCESS
  INSTITUTION_REPORTS
}

model ExamCycle {
  id           String          @id @default(uuid()) @db.Uuid
  name         String
  academicYear String          @map("academic_year") // e.g. "2026-2027"
  startDate    DateTime        @map("start_date")
  endDate      DateTime        @map("end_date")
  status       ExamCycleStatus @default(DRAFT)
  createdById  String          @map("created_by_id") @db.Uuid
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  events       ExamCalendar[]

  @@index([status])
  @@index([academicYear])
  @@map("exam_cycles")
}

model ExamCalendar {
  id               String              @id @default(uuid()) @db.Uuid
  cycleId          String              @map("cycle_id") @db.Uuid
  examId           String              @map("exam_id") @db.Uuid
  plannedDate      DateTime            @map("planned_date") // Stored in UTC
  plannedStartTime DateTime            @map("planned_start_time") // Stored in UTC
  plannedEndTime   DateTime            @map("planned_end_time") // Stored in UTC
  timezone         String              @default("Asia/Kolkata")
  status           CalendarEventStatus @default(PLANNED)
  notes            String?
  scheduleVersion  Int                 @default(1) @map("schedule_version")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  cycle            ExamCycle           @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  exam             Exam                @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([cycleId])
  @@index([examId])
  @@index([plannedDate])
  @@index([status])
  @@map("exam_calendars")
}

model FeatureActivation {
  id            String       @id @default(uuid()) @db.Uuid
  featureCode   FeatureCode  @map("feature_code")
  targetType    String       @default("GLOBAL") @map("target_type") // GLOBAL, EXAM, INSTITUTION
  targetId      String       @default("GLOBAL") @map("target_id")
  isActive      Boolean      @default(true) @map("is_active")
  activatedById String?      @map("activated_by_id") @db.Uuid
  activatedAt   DateTime?    @map("activated_at")
  deactivatedById String?    @map("deactivated_by_id") @db.Uuid
  deactivatedAt DateTime?    @map("deactivated_at")
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@unique([featureCode, targetType, targetId])
  @@index([featureCode, isActive])
  @@map("feature_activations")
}

// ═══════════════════════════════════════════════════════════════════
// ORDERS, PAYMENTS & SALES PERFORMANCE
// ═══════════════════════════════════════════════════════════════════

enum OrderStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentGateway {
  RAZORPAY
  STRIPE
  OFFLINE
  UPI
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique @map("order_number")
  userId          String        @map("user_id") @db.Uuid
  studentId       String?       @map("student_id") @db.Uuid
  salesAgentId    String?       @map("sales_agent_id") @db.Uuid
  examTargetId    String?       @map("exam_target_id") @db.Uuid
  examId          String?       @map("exam_id") @db.Uuid
  amount          Float
  currency        String        @default("INR")
  status          OrderStatus   @default(PENDING)
  itemType        String        @default("EXAM_SERIES") @map("item_type") // EXAM_SERIES, CRASH_COURSE, INSTITUTION_LICENSE
  itemName        String        @map("item_name")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  student         Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  salesAgent      User?         @relation("SalesAgentOrders", fields: [salesAgentId], references: [id], onDelete: SetNull)
  examTarget      ExamTarget?   @relation(fields: [examTargetId], references: [id])
  exam            Exam?         @relation(fields: [examId], references: [id])
  payments        Payment[]

  @@index([userId])
  @@index([studentId])
  @@index([salesAgentId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model Payment {
  id               String         @id @default(uuid()) @db.Uuid
  orderId          String         @map("order_id") @db.Uuid
  paymentNumber    String         @unique @map("payment_number")
  amount           Float
  currency         String         @default("INR")
  gateway          PaymentGateway @default(RAZORPAY)
  gatewayPaymentId String?        @map("gateway_payment_id")
  gatewayOrderId   String?        @map("gateway_order_id")
  status           PaymentStatus  @default(INITIATED)
  paidAt           DateTime?      @map("paid_at")
  refundedAmount   Float          @default(0) @map("refunded_amount")
  refundedAt       DateTime?      @map("refunded_at")
  errorMessage     String?        @map("error_message")
  metadata         Json?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@index([paidAt])
  @@map("payments")
}

model SalesLead {
  id              String         @id @default(uuid()) @db.Uuid
  salesAgentId    String         @map("sales_agent_id") @db.Uuid
  studentId       String?        @map("student_id") @db.Uuid
  leadName        String         @map("lead_name")
  leadPhone       String         @map("lead_phone")
  leadEmail       String?        @map("lead_email")
  state           String?
  district        String?
  targetExam      String?        @map("target_exam")
  status          String         @default("NEW") // NEW, CONTACTED, QUALIFIED, CONVERTED, LOST
  convertedAt     DateTime?      @map("converted_at")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  salesAgent      User           @relation("SalesAgentLeads", fields: [salesAgentId], references: [id], onDelete: Cascade)
  student         Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([salesAgentId])
  @@index([status])
  @@index([createdAt])
  @@map("sales_leads")
}

// ═══════════════════════════════════════════════════════════════════
// QUESTION BANK BULK IMPORT
// ═══════════════════════════════════════════════════════════════════

enum QuestionImportStatus {
  UPLOADED
  PROCESSING
  VALIDATED
  READY_TO_IMPORT
  IMPORTING
  COMPLETED
  FAILED
  CANCELLED
}

enum QuestionImportRowStatus {
  PENDING
  VALID
  INVALID
  DUPLICATE
  UPDATE_AVAILABLE
}

enum QuestionImportRowAction {
  CREATE
  UPDATE
  NONE
}

model QuestionImport {
  id                String                 @id @default(uuid()) @db.Uuid
  fileName          String                 @map("file_name")
  fileType          String                 @map("file_type")
  storageKey        String?                @map("storage_key")
  fileSize          Int?                   @map("file_size")
  checksum          String?
  status            QuestionImportStatus   @default(UPLOADED)
  totalRows         Int                    @default(0) @map("total_rows")
  validRows         Int                    @default(0) @map("valid_row_count")
  invalidRows       Int                    @default(0) @map("invalid_row_count")
  duplicateRows     Int                    @default(0) @map("duplicate_row_count")
  updateRows        Int                    @default(0) @map("update_row_count")
  createRows        Int                    @default(0) @map("create_row_count")
  processedRows     Int                    @default(0) @map("processed_row_count")
  createdCount      Int                    @default(0) @map("created_count")
  updatedCount      Int                    @default(0) @map("updated_count")
  failedCount       Int                    @default(0) @map("failed_count")
  errorSummary      String?                @map("error_summary") @db.Text
  createdById       String                 @map("created_by_id") @db.Uuid
  startedAt         DateTime?              @map("started_at")
  completedAt       DateTime?              @map("completed_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  createdBy         User                   @relation("QuestionImportCreatedBy", fields: [createdById], references: [id])
  rows              QuestionImportRow[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@map("question_imports")
}

model QuestionImportRow {
  id                String                  @id @default(uuid()) @db.Uuid
  importId          String                  @map("import_id") @db.Uuid
  rowNumber         Int                     @map("row_number")
  status            QuestionImportRowStatus @default(PENDING)
  action            QuestionImportRowAction @default(CREATE)
  targetQuestionId  String?                 @map("target_question_id") @db.Uuid
  rawData           Json                    @map("raw_data")
  normalizedData    Json?                   @map("normalized_data")
  dtoData           Json?                   @map("dto_data")
  errors            Json?                   @map("errors") // string[]
  warnings          Json?                   @map("warnings") // string[]
  importStatus      String?                 @default("PENDING") @map("import_status") // PENDING, SUCCESS, FAILED, SKIPPED
  importError       String?                 @map("import_error") @db.Text
  resultQuestionId  String?                 @map("result_question_id") @db.Uuid
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  import            QuestionImport          @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId])
  @@index([status])
  @@index([action])
  @@map("question_import_rows")
}

