  calendars                  ExamCalendar[]
  orders                     Order[]
  resultPublications         ExamResultPublication[]

  @@index([examTargetId])
  @@index([statusId])
  @@index([examDate])
  @@index([securityProfileId])
  @@map("exams")
}



model ExamLanguage {
