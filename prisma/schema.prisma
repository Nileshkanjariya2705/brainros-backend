  createdBy                  User              @relation("ExamCreatedBy", fields: [createdById], references: [id])
  approvedBy                 User?             @relation("ExamApprovedBy", fields: [approvedById], references: [id])
  securityProfile            ExamSecurityProfile? @relation(fields: [securityProfileId], references: [id])
  sections                   ExamSection[]
