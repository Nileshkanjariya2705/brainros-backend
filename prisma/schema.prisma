}

// ═══════════════════════════════════════════════════════════════════
// STUDENT EXAM ATTEMPTS
// ═══════════════════════════════════════════════════════════════════

model AttemptStatus {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  attempts  Attempt[]

  @@map("attempt_statuses")
}

model Attempt {
  id                      String                  @id @default(uuid()) @db.Uuid
  studentId               String                  @map("student_id") @db.Uuid
  examId                  String                  @map("exam_id") @db.Uuid
  statusId                String                  @map("status_id") @db.Uuid
  languageId              String                  @map("language_id") @db.Uuid
  displayLanguageId       String?                 @map("display_language_id") @db.Uuid
  randomSeed              String?                 @map("random_seed")
  startedAt               DateTime?               @map("started_at")
  submittedAt             DateTime?               @map("submitted_at")
  serverStartTime         DateTime?               @map("server_start_time")
  serverEndTime           DateTime?               @map("server_end_time")
  ipAddress               String?                 @map("ip_address")
  securityProfileId       String?                 @map("security_profile_id") @db.Uuid
  securityProfileVersion  Int?                    @default(1) @map("security_profile_version")
  riskScore               Float                   @default(0) @map("risk_score")
  riskLevel               AttemptRiskLevel        @default(LOW) @map("risk_level")
  isFlagged               Boolean                 @default(false) @map("is_flagged")
  disqualifiedAt          DateTime?               @map("disqualified_at")
  disqualificationReason  String?                 @map("disqualification_reason")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")
  student                 Student                 @relation(fields: [studentId], references: [id])
  exam                    Exam                    @relation(fields: [examId], references: [id])
  status                  AttemptStatus           @relation(fields: [statusId], references: [id])
  language                PreferredLanguage       @relation(fields: [languageId], references: [id])
  examVersionId           String?                 @map("exam_version_id") @db.Uuid
  scheduleId              String?                 @map("schedule_id") @db.Uuid
  securityProfile         ExamSecurityProfile?    @relation(fields: [securityProfileId], references: [id])
  answers                 Answer[]
  timeLogs                QuestionTimeLog[]
  timeAnalyses            TimeAnalysis[]
  strategyAnalyses        StrategyAnalysis[]
  candidateRanks          CandidateRank[]
  predictionResults       PredictionResult[]
  result                  Result?
  examVersion             ExamVersion?            @relation(fields: [examVersionId], references: [id])
  schedule                ExamSchedule?           @relation(fields: [scheduleId], references: [id])
  attemptQuestions        AttemptQuestion[]
  examSessions            ExamSession[]
  attemptEvents           AttemptEvent[]
  securityAcceptances     AttemptSecurityAcceptance[]
  securityReviews         AttemptSecurityReview[]

  @@index([studentId, examId])
  @@index([studentId])
  @@index([examId])
  @@index([statusId])
  @@index([riskLevel])
  @@index([isFlagged])
  @@map("attempts")
}

model ExamSecurityProfile {
  id                          String                    @id @default(uuid()) @db.Uuid
  name                        String                    @unique
  code                        String                    @unique
  description                 String?
  level                       ExamSecurityLevel         @default(STANDARD)
  fullscreenRequired          Boolean                   @default(false) @map("fullscreen_required")
  preventCopyPaste            Boolean                   @default(false) @map("prevent_copy_paste")
  preventContextMenu          Boolean                   @default(false) @map("prevent_context_menu")
  preventTextSelection        Boolean                   @default(false) @map("prevent_text_selection")
  detectTabSwitch             Boolean                   @default(true) @map("detect_tab_switch")
  detectWindowBlur            Boolean                   @default(true) @map("detect_window_blur")
  detectFullscreenExit        Boolean                   @default(false) @map("detect_fullscreen_exit")
  detectMultipleSessions      Boolean                   @default(true) @map("detect_multiple_sessions")
  allowNetworkOffline         Boolean                   @default(true) @map("allow_network_offline")
  singleSessionRequired       Boolean                   @default(false) @map("single_session_required")
  singleDeviceRequired        Boolean                   @default(false) @map("single_device_required")
  maxTabSwitches              Int                       @default(3) @map("max_tab_switches")
  maxFullscreenExits          Int                       @default(2) @map("max_fullscreen_exits")
  warningThreshold            Int                       @default(2) @map("warning_threshold")
  autoTerminateThreshold      Int                       @default(10) @map("auto_terminate_threshold")
  heartbeatIntervalSeconds    Int                       @default(30) @map("heartbeat_interval_seconds")
  version                     Int                       @default(1)
  isActive                    Boolean                   @default(true) @map("is_active")
  createdAt                   DateTime                  @default(now()) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @map("updated_at")
  exams                       Exam[]
  attempts                    Attempt[]
  rules                       ExamSecurityRule[]
  acceptances                 AttemptSecurityAcceptance[]

  @@map("exam_security_profiles")
}

model ExamSecurityRule {
  id                String              @id @default(uuid()) @db.Uuid
  profileId         String              @map("profile_id") @db.Uuid
  ruleCode          String              @map("rule_code")
  eventType         String              @map("event_type")
  threshold         Int                 @default(1)
  weight            Float               @default(5)
  action            SecurityActionType  @default(WARN)
  enabled           Boolean             @default(true)
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  profile           ExamSecurityProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, ruleCode])
  @@index([profileId])
  @@map("exam_security_rules")
}

model ExamSession {
  id                String              @id @default(uuid()) @db.Uuid
  attemptId         String              @map("attempt_id") @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  clientType        SecurityClientType  @default(STANDARD_BROWSER) @map("client_type")
  clientVersion     String?             @map("client_version")
  deviceMetadata    Json?               @map("device_metadata")
  userAgent         String?             @map("user_agent")
  ipAddress         String?             @map("ip_address")
  startedAt         DateTime            @default(now()) @map("started_at")
  lastHeartbeatAt   DateTime            @default(now()) @map("last_heartbeat_at")
  status            ExamSessionStatus   @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  attempt           Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  user              User                @relation(fields: [userId], references: [id])
  events            AttemptEvent[]

  @@index([attemptId])
  @@index([userId])
  @@index([status])
  @@map("exam_sessions")
}

model AttemptEvent {
  id                String              @id @default(uuid()) @db.Uuid
  eventId           String              @unique @map("event_id")
  attemptId         String              @map("attempt_id") @db.Uuid
  examSessionId     String?             @map("exam_session_id") @db.Uuid
  eventType         String              @map("event_type")
  sequenceNumber    Int                 @default(1) @map("sequence_number")
  clientTimestamp   DateTime?           @map("client_timestamp")
  serverTimestamp   DateTime            @default(now()) @map("server_timestamp")
  duration          Int?                @default(0)
  metadata          Json?
  createdAt         DateTime            @default(now()) @map("created_at")
  attempt           Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examSession       ExamSession?        @relation(fields: [examSessionId], references: [id], onDelete: SetNull)

  @@index([attemptId, serverTimestamp])
  @@index([attemptId, eventType])
  @@index([examSessionId])
  @@map("attempt_events")
}

model AttemptSecurityAcceptance {
  id                String              @id @default(uuid()) @db.Uuid
  attemptId         String              @map("attempt_id") @db.Uuid
  securityProfileId String              @map("security_profile_id") @db.Uuid
  policyVersion     Int                 @default(1) @map("policy_version")
  acceptedAt        DateTime            @default(now()) @map("accepted_at")
  ipAddress         String?             @map("ip_address")
  userAgent         String?             @map("user_agent")
  attempt           Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  securityProfile   ExamSecurityProfile @relation(fields: [securityProfileId], references: [id])

  @@unique([attemptId, securityProfileId, policyVersion])
  @@index([attemptId])
  @@map("attempt_security_acceptances")
}

model AttemptSecurityReview {
  id                String                @id @default(uuid()) @db.Uuid
  attemptId         String                @map("attempt_id") @db.Uuid
  status            SecurityReviewStatus  @default(PENDING)
  reviewedById      String?               @map("reviewed_by_id") @db.Uuid
  reason            String?
  notes             String?               @db.Text
  reviewedAt        DateTime?             @map("reviewed_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  attempt           Attempt               @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  reviewedBy        User?                 @relation(fields: [reviewedById], references: [id])

  @@index([attemptId])
  @@index([status])
  @@map("attempt_security_reviews")
}

model AttemptQuestion {
  id             String                  @id @default(uuid()) @db.Uuid
  attemptId      String                  @map("attempt_id") @db.Uuid
  examQuestionId String                  @map("exam_question_id") @db.Uuid
  displayOrder   Int                     @map("display_order")
  sectionId      String?                 @map("section_id") @db.Uuid
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  attempt        Attempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion   ExamQuestion            @relation(fields: [examQuestionId], references: [id], onDelete: Cascade)
  options        AttemptQuestionOption[]

  @@unique([attemptId, examQuestionId])
  @@index([attemptId, displayOrder])
  @@map("attempt_questions")
}

model AttemptQuestionOption {
  id                   String          @id @default(uuid()) @db.Uuid
  attemptQuestionId    String          @map("attempt_question_id") @db.Uuid
  examQuestionOptionId String          @map("exam_question_option_id") @db.Uuid
  displayOrder         Int             @map("display_order")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  attemptQuestion      AttemptQuestion @relation(fields: [attemptQuestionId], references: [id], onDelete: Cascade)
  examQuestionOption   QuestionOption  @relation(fields: [examQuestionOptionId], references: [id], onDelete: Cascade)

  @@unique([attemptQuestionId, examQuestionOptionId])
  @@index([attemptQuestionId, displayOrder])
  @@map("attempt_question_options")
}


model Answer {
  id              String          @id @default(uuid()) @db.Uuid
  attemptId       String          @map("attempt_id") @db.Uuid
  examQuestionId  String          @map("exam_question_id") @db.Uuid
  selectedOptionId String?        @map("selected_option_id") @db.Uuid
  numericalAnswer  Float?        @map("numerical_answer")
  selectedOptions  Json?         @map("selected_options")
  isMarkedForReview Boolean      @default(false) @map("is_marked_for_review")
  answeredAt       DateTime?     @map("answered_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  attempt         Attempt        @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion    ExamQuestion   @relation(fields: [examQuestionId], references: [id])
  selectedOption  QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, examQuestionId])
  @@index([attemptId])
  @@map("answers")
}

model QuestionTimeLog {
  id               String       @id @default(uuid()) @db.Uuid
  attemptId        String       @map("attempt_id") @db.Uuid
  examQuestionId   String       @map("exam_question_id") @db.Uuid
  startTime        DateTime     @map("start_time")
  endTime          DateTime?    @map("end_time")
  timeSpentSeconds Int          @default(0) @map("time_spent_seconds")
  visitNumber      Int          @default(1) @map("visit_number")
  source           String       @default("CLIENT_EVENT") // CLIENT_EVENT, SERVER_TRANSITION, SUBMIT, AUTO_SUBMIT, RECOVERY
  eventId          String?      @map("event_id")
  clientTimestamp  DateTime?    @map("client_timestamp")
  clientSequence   Int?         @map("client_sequence")
  metadata         Json?
  createdAt        DateTime     @default(now()) @map("created_at")
  attempt          Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examQuestion     ExamQuestion @relation(fields: [examQuestionId], references: [id])

  @@index([attemptId])
  @@index([attemptId, examQuestionId])
  @@index([attemptId, startTime])
  @@index([eventId])
  @@map("question_time_logs")
}

model TimeAnalysis {
  id                                String   @id @default(uuid()) @db.Uuid
  attemptId                         String   @map("attempt_id") @db.Uuid
  analysisVersion                   Int      @default(1) @map("analysis_version")
  algorithmVersion                  String   @default("v1.0.0") @map("algorithm_version")
  totalTimeAvailableSeconds         Int      @map("total_time_available_seconds")
  totalTimeUsedSeconds              Int      @map("total_time_used_seconds")
  timeRemainingSeconds              Int      @map("time_remaining_seconds")
  timeUtilizationPercentage         Float    @map("time_utilization_percentage")
  averageTimePerQuestionSeconds     Float    @map("average_time_per_question_seconds")
  averageTimePerAttemptedQuestion   Float    @map("average_time_per_attempted_question")
  medianTimePerQuestionSeconds      Float    @map("median_time_per_question_seconds")
  timeWastedSeconds                 Int      @default(0) @map("time_wasted_seconds")
  fastestQuestionId                 String?  @map("fastest_question_id") @db.Uuid
  slowestQuestionId                 String?  @map("slowest_question_id") @db.Uuid
  data                              Json     // Full detailed snapshot
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")
  attempt                           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, analysisVersion])
  @@index([attemptId])
  @@map("time_analyses")
}

model StrategyRule {
  id                     String    @id @default(uuid()) @db.Uuid
  code                   String    @unique // e.g. HIGH_RISK_ATTEMPTING, UNDER_ATTEMPTING
  name                   String
  description            String?
  category               String    // ATTEMPT_COVERAGE, RISK, NEGATIVE_MARKING, TIME_MANAGEMENT, QUESTION_SELECTION, REVIEW_BEHAVIOR
  metric                 String    // WRONG_HARD_QUESTIONS, ATTEMPTED_PERCENTAGE, etc.
  operator               String    // GT, GTE, LT, LTE, EQ, BETWEEN, PERCENT_GT, PERCENT_LT
  threshold              Float
  comparisonValue        Float?    @map("comparison_value")
  severity               String    @default("MEDIUM") // INFO, LOW, MEDIUM, HIGH, CRITICAL
  priority               Int       @default(1)
  recommendationTemplate String    @map("recommendation_template") @db.Text
  titleTemplate          String    @default("Strategy Recommendation") @map("title_template")
  isActive               Boolean   @default(true) @map("is_active")
  configVersion          Int       @default(1) @map("config_version")
  examTargetId           String?   @map("exam_target_id") @db.Uuid
  examId                 String?   @map("exam_id") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([category])
  @@index([isActive])
  @@map("strategy_rules")
}

model StrategyAnalysis {
  id                                String   @id @default(uuid()) @db.Uuid
  attemptId                         String   @map("attempt_id") @db.Uuid
  strategyVersion                   Int      @default(1) @map("strategy_version")
  algorithmVersion                  String   @default("v1.0.0") @map("algorithm_version")
  primaryClassification            String   @default("BALANCED") @map("primary_classification")
  classifications                   String[]
  metrics                           Json     // Map of all computed StrategyMetrics
  recommendations                   Json     // Array of structured StrategyRecommendations
  projectedImprovementMarks         Float    @default(0) @map("projected_improvement_marks")
  projectedScore                    Float    @default(0) @map("projected_score")
  avoidableNegativeMarks            Float    @default(0) @map("avoidable_negative_marks")
  data                              Json     // Complete snapshot
  createdAt                         DateTime @default(now()) @map("created_at")
  updatedAt                         DateTime @updatedAt @map("updated_at")
  attempt                           Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, strategyVersion])
  @@index([attemptId])
  @@map("strategy_analyses")
}

// ═══════════════════════════════════════════════════════════════════
// RESULTS & ANALYTICS
// ═══════════════════════════════════════════════════════════════════

enum ExamPublicationStatus {
  NOT_READY
  PROCESSING
  READY_TO_PUBLISH
  PUBLISHED
  WITHHELD
}

model Result {
  id                      String          @id @default(uuid()) @db.Uuid
  attemptId               String          @unique @map("attempt_id") @db.Uuid
  resultStatus            String          @default("PROCESSING") @map("result_status")
  totalQuestions          Int             @map("total_questions")
  correctAnswers          Int             @map("correct_answers")
