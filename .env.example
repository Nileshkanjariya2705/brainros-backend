# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brainros_db?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="your-super-secret-jwt-key"
JWT_ACCESS_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Question Management Feature Flags (Defaults to false if missing)
FEATURE_ADD_QUESTION=false
FEATURE_BULK_IMPORT_QUESTION=false
FEATURE_QUESTION_BANK=false
FEATURE_BULK_IMPORT_TRANSLATION=false
