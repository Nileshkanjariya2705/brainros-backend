# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brainros_db?schema=public"

# Authentication & JWT Secrets
JWT_SECRET="your-super-secret-jwt-key"
JWT_ACCESS_SECRET="your-super-secret-jwt-key"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000,http://localhost:3001,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:5173"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Question Management Feature Flags (Defaults to false if missing)
FEATURE_ADD_QUESTION=false
FEATURE_BULK_IMPORT_QUESTION=false
FEATURE_QUESTION_BANK=false
FEATURE_BULK_IMPORT_TRANSLATION=false

# Two-Factor Authentication (2FA) / OTP Configuration
# true  = send real SMS OTP via MSG91 OTP API
# false = use development OTP bypass code (12345)
ENABLE_REAL_OTP=false
ENABLE_2FA=false

# Development bypass OTP. Used only when ENABLE_REAL_OTP=false.
DEV_BYPASS_OTP=12345

# MSG91 OTP Gateway Configuration
MSG91_AUTH_KEY="567446A9gJtDpx6a9a2e53P1"
MSG91_TEMPLATE_ID="6a9a366caea18f1a81002b07"
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Email & Resend Configuration
EMAIL_API_KEY=""
EMAIL_FROM="Brainros <onboarding@resend.dev>"
