# ==============================================================================
# Brainros Backend Environment Configuration Template
# Copy this file to .env or .env.production and fill in your real credentials.
# NEVER commit your actual .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@host:5432/database_name?sslmode=require"
DIRECT_URL="postgresql://username:password@host:5432/database_name?sslmode=require"

# Redis & Queue Configuration
# Set REDIS_ENABLED=false to run in fault-tolerant in-memory mode without Redis or BullMQ.
REDIS_ENABLED=true
REDIS_URL="redis://:password@host:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets (CRITICAL: Change these in production!)
JWT_SECRET=""
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
SESSION_EXPIRY_DAYS=30

# Cookie Configuration
COOKIE_DOMAIN=""
COOKIE_SAME_SITE="lax"
COOKIE_SECURE=true

# Google OAuth Configuration
GOOGLE_CLIENT_ID=""

# CORS Configuration
# Comma-separated list of allowed frontend origins (no trailing slashes, no wildcard in prod)
FRONTEND_URL="https://brainros.com,https://www.brainros.com"

# Rate Limiting (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Question Management Feature Flags
FEATURE_ADD_QUESTION=false
FEATURE_BULK_IMPORT_QUESTION=false
FEATURE_QUESTION_BANK=false
FEATURE_BULK_IMPORT_TRANSLATION=false

# Two-Factor Authentication (2FA) / SMS Gateway Configuration
# IMPORTANT: In production, ENABLE_REAL_OTP must be true, and BYPASS_OTP / LOGIN_OTP_DATABASE_MODE must be false.
# The server will abort startup if auth bypass flags are enabled in production.
ENABLE_REAL_OTP=true
ENABLE_2FA=true
ENABLE_OTP=true
BYPASS_OTP=false
LOGIN_OTP_DATABASE_MODE=false
DEV_BYPASS_OTP=""
DEV_OTP_CODE=""
DEV_LOGIN_OTP=""

# Active OTP Provider: "2FACTOR" or "MSG91"
OTP_PROVIDER="2FACTOR"

# 2Factor.in Gateway (Used when OTP_PROVIDER="2FACTOR")
TWO_FACTOR_API_KEY=""
TWOFACTOR_API_KEY=""
OTP_API_KEY=""
TWO_FACTOR_TEMPLATE_NAME=""

# MSG91 Gateway (Used when OTP_PROVIDER="MSG91")
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""

# OTP Parameter Controls
OTP_LENGTH=5
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_REQUESTS_PER_HOUR=5

# Email & Resend Configuration
EMAIL_API_KEY=""
EMAIL_FROM="Brainros <noreply@yourdomain.com>"

# Storage / AWS S3 Configuration (Optional - falls back to local storage/reports if unset)
S3_BUCKET="brainros-reports"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="us-east-1"
APP_URL="http://localhost:3000"

# Logging Configuration
LOG_LEVEL="info"
SLOW_REQUEST_THRESHOLD_MS=1000
ENABLE_HTTP_BODY_LOGGING=false
